# --- Secrets -------------------------------------------------------------
# Never commit. env/.env.example is the committed template. These patterns
# carry no slash, so they match at any depth - env/.env is covered, and the
# negation keeps env/.env.example tracked.
.env
.env.*
!.env.example
*.key

# --- Copyrighted curriculum source --------------------------------------
# Source PDFs belong to their authors (Tuto Academy) and are not ours to
# redistribute. Users supply their own — see the README.
data/*.pdf
*.pdf
# Course folders (data/<niveau>/<matière>/<chapitre>/...) hold the same
# material in other forms too - a Markdown transcription of a chapter is still
# the author's content. Anything under a data/ subfolder stays local; only
# top-level project notes like data/mvp-roadmap.md are tracked.
data/*/

# chunks.json is extracted text from those PDFs, so it inherits the same
# restriction. Regenerate it with extract_chapter.py.
chunks.json

# --- Generated / regeneratable ------------------------------------------
# Vector store: rebuild with rag_store.py from your own chunks.json.
chroma_db/

# --- Python --------------------------------------------------------------
.venv/
__pycache__/
*.py[cod]

# --- Node / UI -----------------------------------------------------------
node_modules/
ui/dist/
*.local

# --- Editor / scratch ----------------------------------------------------
Untitled-*.algo
.vscode/
.idea/
.DS_Store

# Playwright MCP writes console logs and screenshots here during browser
# checks; they are local debugging output, not project files.
.playwright-mcp/

# Test problems are transcribed verbatim from the curriculum PDF, so they
# inherit the same restriction as chunks.json. Copy
# sample_problems.example.json and fill it with your own exercises.
sample_problems.json
