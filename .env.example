# Copy to .env and paste your real key. .env is gitignored - never commit it.
GROQ_API_KEY=gsk_your_key_here
# Optional override; defaults to openai/gpt-oss-120b
# GROQ_MODEL=openai/gpt-oss-120b

# --- PostgreSQL --------------------------------------------------------------
# Only needed if you run migrations or scripts from the host. docker compose
# already injects DATABASE_URL into the backend container with host
# `postgres`; this default uses `localhost` because that is what the host sees
# through the published 5432 port.
#
# The credentials below match the POSTGRES_* values in docker-compose.yml. They
# are dev-only throwaways - a real deployment sets DATABASE_URL to a managed
# instance and never uses these.
# DATABASE_URL=postgresql+psycopg://fahem:fahem@localhost:5432/fahem

# --- Qdrant (vector store) ---------------------------------------------------
# Same shape as DATABASE_URL above: docker compose injects QDRANT_URL into the
# backend container with host `qdrant`; this default uses `localhost` because
# that is what the host sees through the published 6333 port.
#
# No API key here on purpose - the compose stack keeps Qdrant on the internal
# Docker network. A real deployment must enable Qdrant's API key auth and set
# QDRANT_API_KEY, otherwise the store is readable and writable by anything
# that can reach the port.
# QDRANT_URL=http://localhost:6333

# --- Auth (Google sign-in + session cookie) ----------------------------------
# GOOGLE_CLIENT_ID is the OAuth 2.0 Client ID from the project's Google Cloud
# console (APIs & Services > Credentials, after configuring the OAuth consent
# screen). It has no default: it is what the ID token's `aud` claim is checked
# against, and auth.py refuses to verify a token at all while it is empty
# rather than accepting one with an unchecked audience.
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# PRE-LAUNCH: SESSION_SECRET_KEY must be set to a real random value in any
# deployment. The code's fallback is a *published* string - anyone reading the
# repo could sign a session token for any user id. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# SESSION_SECRET_KEY=

# 7 days by default.
# SESSION_TTL_SECONDS=604800

# PRE-LAUNCH: set true wherever the site is served over https.
# SESSION_COOKIE_SECURE=false
# `lax` is correct when the UI and API share a registrable domain. See
# config.py for why the current localhost:5173 -> 127.0.0.1:8000 dev setup
# does not, and what the frontend phase has to change.
# SESSION_COOKIE_SAMESITE=lax

# --- Email + password accounts (Phase 4) -------------------------------------
# Resend API key (https://resend.com -> API Keys). Required for verification
# and password-reset emails; with it empty, sends are refused and logged as
# "email NOT sent" - never faked. Signup and login still work without it.
# RESEND_API_KEY=re_xxxxxxxx

# Sender. Must be on a domain verified in Resend. The default,
# onboarding@resend.dev, only delivers to the Resend account owner's own
# address - fine for testing, useless for real students.
# EMAIL_FROM=Fahem <noreply@your-verified-domain.tn>

# Where email links point. The reset link goes to the app (token in the URL
# fragment, which never reaches a server log); the verify link goes to the API.
# APP_BASE_URL=http://localhost:5173
# PUBLIC_API_URL=http://localhost:8000
